DATABASE_PATH=./data/test-drive.sqlite
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional. Without a key, task generation offers a labeled preset; voice and résumé AI are unavailable.
# Models are hardcoded in lib/openrouter.ts (Haiku 5.5 text/PDF; Whisper transcription).
OPENROUTER_API_KEY=
# Demo login is enabled locally. Explicitly enable it for a public demo deployment.
ENABLE_DEMO_AUTH=false
