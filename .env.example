DATABASE_PATH=./data/test-drive.sqlite
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Optional. Without a key, the editor offers an explicitly labeled simulated draft.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Voice project drafts require a live API key (no simulated transcription).
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3-turbo
# Demo login is enabled locally. Explicitly enable it for a public demo deployment.
ENABLE_DEMO_AUTH=false
